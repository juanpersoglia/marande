{
  "name": "historia-clinica-digital",
  "private": true,
  "version": "1.0.0",
  "description": "Historia Clínica Digital para institutos de atención a la discapacidad",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:api": "VITE_STORAGE=api vite",
    "server": "node server/index.js",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "build:api": "tsc --noEmit && VITE_STORAGE=api vite build",
    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "express": "^5.3.0",
    "lucide-react": "^1.79.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
